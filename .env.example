# ===========================================================================
#  Plantilla de variables de entorno  -  proyecto-bi-oee
#  ---------------------------------------------------------------------------
#  Copie este archivo a `.env` y reemplace los valores. `.env` esta excluido
#  del repositorio por `.gitignore`; este `.env.example` SI se versiona para
#  documentar que variables necesita la solucion.
#
#      cp .env.example .env     &&     $EDITOR .env
# ===========================================================================

# --- PostgreSQL (motor del repositorio analitico) --------------------------
POSTGRES_DB=bi_oee
POSTGRES_USER=bi_admin
POSTGRES_PASSWORD=CAMBIE_ESTA_CLAVE_admin
# Puerto publicado en el equipo anfitrion (DBeaver y Power BI se conectan aqui).
# Se usa 55432 en lugar de 5432 para no chocar con un PostgreSQL instalado localmente.
POSTGRES_PORT_HOST=55432

# --- Rol de solo lectura usado por Grafana y Power BI ----------------------
# Principio de minimo privilegio: este rol NO puede ver el esquema `pii`.
BI_READONLY_USER=bi_lectura
BI_READONLY_PASSWORD=CAMBIE_ESTA_CLAVE_lectura

# --- Semilla de pseudonimizacion ------------------------------------------
# Se usa para derivar los codigos de operario/tecnico (HMAC-SHA256). Cambiarla
# invalida la trazabilidad historica de los pseudonimos: trate esta semilla
# como un secreto y NO la publique.
ETL_SALT_PSEUDONIMO=CAMBIE_ESTA_SEMILLA_aleatoria_larga

# --- Grafana (tablero operativo) ------------------------------------------
GRAFANA_PORT_HOST=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CAMBIE_ESTA_CLAVE_grafana
# Los visores del tablero no deben poder editarlo ni ver otras organizaciones.
GF_USERS_ALLOW_SIGN_UP=false
GF_USERS_DEFAULT_THEME=light
GF_AUTH_ANONYMOUS_ENABLED=false

# --- Simulador hora a hora (demostracion near real-time) ------------------
# Segundos de reloj que representan una hora de planta. 20 => un turno de
# 8 horas se simula en ~2.7 minutos, suficiente para la sustentacion en vivo.
SIM_SEGUNDOS_POR_HORA=20
# Probabilidad de que una hora simulada presente un paro no planeado.
SIM_PROB_PARO=0.35
# Fuerza una caida de OEE para demostrar que la alerta se dispara.
SIM_FORZAR_INCIDENTE=true

# --- Zona horaria comun a todos los contenedores --------------------------
TZ=America/Bogota

# --- Parametros del incidente simulado -------------------------------------
# El simulador provoca a proposito una falla sostenida en una linea para
# demostrar que el tablero y la alerta de Grafana reaccionan. Valores por
# defecto: Vinilos_2 (la linea con peor disponibilidad historica, 62,6% en
# 2024, asi que el incidente es verosimil), a partir de la tercera hora
# simulada y durante ocho horas.
SIM_HORAS_HISTORIA=48
SIM_MAQUINA_INCIDENTE=Vinilos_2
SIM_HORA_INICIO_INCIDENTE=3
SIM_DURACION_INCIDENTE=8
