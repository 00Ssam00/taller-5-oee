                  {
                    "type": "value",
                    "options": {
                      "Vital": {
                        "color": "red",
                        "index": 0
                      },
                      "Trivial": {
                        "color": "text",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
