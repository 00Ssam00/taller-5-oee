/// Los turnos de trabajo. Incluye los miembros de relleno 'No aplica' y
/// 'Descanso' para no usar NULL en la tabla de hechos.
table Turno
	lineageTag: c693af36-f5b1-5451-b1c8-0ef84506ddab

	/// Llave surrogada.
	column turno_key
		dataType: int64
		isHidden
