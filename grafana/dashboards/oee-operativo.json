    {
      "type": "bargauge",
      "title": "OEE actual por linea",
      "description": "OEE de la ultima hora reportada por cada linea. Verde: cumple la meta de 65%. Naranja: por debajo de la meta. Rojo: por debajo del umbral critico de 50%, que es el que dispara la alerta.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bioee-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bioee-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT codigo_maquina AS \"Linea\", oee_pct AS \"OEE\"\nFROM dw.v_estado_actual_maquina\nWHERE codigo_maquina IN (${maquina:sqlstring})\nORDER BY codigo_maquina",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
