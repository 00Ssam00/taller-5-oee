    {
      "type": "timeseries",
      "title": "OEE hora a hora por linea",
      "description": "Serie de tiempo del OEE de cada linea. La linea punteada roja es el umbral critico (50%) y la verde la meta (65%). Cuando el simulador provoca el incidente, la curva de la linea afectada cruza el umbral rojo y la alerta pasa a estado de disparo.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bioee-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bioee-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n    $__timeGroupAlias(k.instante, $intervalo),\n    k.codigo_maquina AS metric,\n    avg(k.oee_pct)   AS \"OEE\"\nFROM dw.v_kpi_hora k\nJOIN dw.dim_maquina m ON m.codigo_maquina = k.codigo_maquina\nJOIN dw.dim_turno   t ON t.codigo_turno   = k.codigo_turno\nWHERE $__timeFilter(k.instante)\n  AND m.codigo_maquina IN (${maquina:sqlstring})\n      AND t.codigo_turno IN (${turno:sqlstring})\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "pointSize": 5,
            "axisSoftMin": 0,
            "axisSoftMax": 100,
            "gradientMode": "opacity",
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "mean",
            "min"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Componentes del OEE (planta)",
      "description": "Descompone el OEE en Disponibilidad, Rendimiento y Calidad. Permite ver si el problema es que la maquina esta parada, que corre lenta o que produce reproceso: son tres responsables distintos.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bioee-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bioee-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n    $__timeGroupAlias(k.instante, $intervalo),\n    round(100 * sum(k.minutos_operativos) / sum(k.minutos_operativos + k.minutos_paro), 2) AS \"Disponibilidad\",\n    round(100 * sum(k.unidades_producidas)::numeric / nullif(sum(k.unidades_posibles), 0), 2) AS \"Rendimiento\",\n    round(100 * (1 - sum(k.unidades_rechazadas)::numeric / nullif(sum(k.unidades_producidas), 0)), 2) AS \"Calidad\"\nFROM dw.v_kpi_hora k\nJOIN dw.dim_maquina m ON m.codigo_maquina = k.codigo_maquina\nJOIN dw.dim_turno   t ON t.codigo_turno   = k.codigo_turno\nWHERE $__timeFilter(k.instante)\n  AND m.codigo_maquina IN (${maquina:sqlstring})\n      AND t.codigo_turno IN (${turno:sqlstring})\nGROUP BY 1\nORDER BY 1",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "axisSoftMax": 100,
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Minutos de paro por hora, segun la causa",
      "description": "Barras apiladas: cuanto tiempo perdio la planta en cada hora y por que. Responde '¿que paso anoche?' sin tener que abrir el Excel.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bioee-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bioee-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n    $__timeGroupAlias(k.instante, $intervalo),\n    coalesce(k.causa_paro, 'Sin paro') AS metric,\n    sum(k.minutos_paro)                AS \"Minutos de paro\"\nFROM dw.v_kpi_hora k\nJOIN dw.dim_maquina m ON m.codigo_maquina = k.codigo_maquina\nJOIN dw.dim_turno   t ON t.codigo_turno   = k.codigo_turno\nWHERE $__timeFilter(k.instante)\n  AND k.minutos_paro > 0\n  AND m.codigo_maquina IN (${maquina:sqlstring})\n      AND t.codigo_turno IN (${turno:sqlstring})\nGROUP BY 1, 2\nORDER BY 1",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 85,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "barAlignment": 0,
            "scaleDistribution": {
              "type": "linear"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9
    },
    {
      "type": "row",
      "title": "Analisis de causas (Pareto)",
      "collapsed": false,
