    {
      "type": "barchart",
      "title": "Pareto de causas de paro del periodo",
      "description": "Las causas ordenadas por tiempo perdido en el rango de tiempo seleccionado. Es el mismo Pareto que el tablero de Power BI, pero sobre el dato de la ultima hora en vez del cierre mensual.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bioee-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bioee-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    k.causa_paro            AS \"Causa\",\n    round(sum(k.minutos_paro) / 60.0, 2) AS \"Horas perdidas\"\nFROM dw.v_kpi_hora k\nJOIN dw.dim_maquina m ON m.codigo_maquina = k.codigo_maquina\nJOIN dw.dim_turno   t ON t.codigo_turno   = k.codigo_turno\nWHERE $__timeFilter(k.instante)\n  AND k.causa_paro IS NOT NULL\n  AND m.codigo_maquina IN (${maquina:sqlstring})\n      AND t.codigo_turno IN (${turno:sqlstring})\nGROUP BY 1\nORDER BY 2 DESC\nLIMIT 12",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 2,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "hue",
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "xTickLabelRotation": 0,
        "xTickLabelMaxLength": 38,
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "id": 11
    },
    {
      "type": "table",
      "title": "Causas con porcentaje acumulado",
      "description": "La misma informacion con el porcentaje acumulado, para identificar el 20% de causas que explica el 80% del tiempo perdido. Las filas marcadas como 'vital' son las que deben entrar al plan de mantenimiento.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bioee-postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bioee-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH causas AS (\n    SELECT k.causa_paro, k.area_impacto,\n           sum(k.minutos_paro) / 60.0 AS horas,\n           count(*) FILTER (WHERE k.minutos_paro > 0) AS eventos\n    FROM dw.v_kpi_hora k\n    JOIN dw.dim_maquina m ON m.codigo_maquina = k.codigo_maquina\n    JOIN dw.dim_turno   t ON t.codigo_turno   = k.codigo_turno\n    WHERE $__timeFilter(k.instante)\n      AND k.causa_paro IS NOT NULL\n      AND m.codigo_maquina IN (${maquina:sqlstring})\n      AND t.codigo_turno IN (${turno:sqlstring})\n    GROUP BY 1, 2\n)\nSELECT\n    causa_paro   AS \"Causa\",\n    area_impacto AS \"Area\",\n    round(horas, 2) AS \"Horas\",\n    eventos         AS \"Eventos\",\n    round(100 * horas / sum(horas) OVER (), 1) AS \"% del total\",\n    round(100 * sum(horas) OVER (ORDER BY horas DESC\n          ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)\n          / sum(horas) OVER (), 1) AS \"% acumulado\",\n    CASE WHEN 100 * sum(horas) OVER (ORDER BY horas DESC\n              ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)\n              / sum(horas) OVER () <= 80\n         THEN 'Vital' ELSE 'Trivial' END AS \"Pareto\"\nFROM causas\nORDER BY horas DESC",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "% acumulado"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.cellOptions",
                "value": {
