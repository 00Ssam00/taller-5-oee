    {
      "type": "table",
      "title": "Detalle del estado actual por linea",
      "description": "Una fila por maquina con su ultimo registro: turno, referencia en proceso, causa del paro vigente y los tres componentes del OEE. Es la pantalla de piso de planta.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bioee-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bioee-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    codigo_maquina          AS \"Linea\",\n    semaforo                AS \"Estado\",\n    oee_pct                 AS \"OEE\",\n    disponibilidad_pct      AS \"Disponibilidad\",\n    rendimiento_pct         AS \"Rendimiento\",\n    calidad_pct             AS \"Calidad\",\n    codigo_turno            AS \"Turno\",\n    nombre_referencia       AS \"Referencia\",\n    coalesce(causa_paro_actual, 'Sin paro') AS \"Causa del paro\",\n    minutos_paro            AS \"Min. paro\",\n    unidades_producidas     AS \"Unidades\",\n    round(minutos_desde_registro) AS \"Min. desde el dato\"\nFROM dw.v_estado_actual_maquina\nWHERE codigo_maquina IN (${maquina:sqlstring})\nORDER BY oee_pct NULLS FIRST",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "OEE|Disponibilidad|Rendimiento|Calidad"
            },
            "properties": [
              {
                "id": "unit",
